# ── Telegram Bot ──────────────────────────────────────────────────
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
BOT_USERNAME=YourGroupBot

# ── Super Admins (comma-separated user IDs) ───────────────────────
SUPER_ADMIN_IDS=123456789,987654321

# ── Database ──────────────────────────────────────────────────────
# SQLite (default):
DATABASE_URL=sqlite+aiosqlite:///bot_data.db
# PostgreSQL (alternative):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/bot_db

# ── Payment ───────────────────────────────────────────────────────
USDT_WALLET_ADDRESS=TRC20WalletAddressHere
TON_WALLET_ADDRESS=TONWalletAddressHere
TELEGRAM_STARS_ENABLED=0

# VIP Pricing (USD)
VIP_MONTHLY_PRICE=9.99
VIP_QUARTERLY_PRICE=24.99
VIP_YEARLY_PRICE=79.99

# ── Carousel ──────────────────────────────────────────────────────
DEFAULT_CAROUSEL_INTERVAL=600

# ── Moderation ────────────────────────────────────────────────────
DEFAULT_WARN_LIMIT=3
DEFAULT_MUTE_DURATION=3600

# ── Anti-Spam ─────────────────────────────────────────────────────
ANTI_SPAM_ENABLED=1
MESSAGE_COOLDOWN=1.5
MAX_MESSAGES_PER_WINDOW=5
SPAM_WINDOW_SECONDS=3.0

# ── Welcome ───────────────────────────────────────────────────────
CAPTCHA_ENABLED=1
CAPTCHA_TIMEOUT=120
WELCOME_AUTO_DELETE=300


# ── AI Service ────────────────────────────────────────────────────
AI_DEFAULT_MODEL=gpt-4o-mini
AI_DEFAULT_API_KEY=your-openai-or-compatible-api-key
AI_DEFAULT_API_BASE=https://api.openai.com/v1
AI_MAX_HISTORY=10
AI_ENABLED=1

# ── Web Admin Panel ───────────────────────────────────────────────
WEB_PANEL_ENABLED=0
WEB_PANEL_HOST=0.0.0.0
WEB_PANEL_PORT=8080
WEB_PANEL_SECRET=change-me-to-a-random-string

# ── Quiet Mode ────────────────────────────────────────────────────
QUIET_MODE_CHECK_INTERVAL=60

# ── Notification ──────────────────────────────────────────────────
NOTIFICATION_AUTO_DELETE=0
# ── General ───────────────────────────────────────────────────────
LOG_LEVEL=INFO
TIMEZONE=Asia/Shanghai

